<?xml version="1.0" encoding="UTF-8"?>
<!-- BN player (skin setting __chooseplayer = __bnplayer): one clear row of big buttons, the focused button's name under
     it, progress bar with times, title on top. Modelled on the Estuary-style OSD (Anonymous TV build) that owners find
     intuitive; BN additions: BN subtitles window, AI subtitles, subtitle sync, audio, picture. -->
<includes>
	<include name="videosd_bn">
		<control type="group">
			<!-- top: title + clock -->
			<control type="image">
				<left>0</left><top>0</top><width>100%</width><height>220</height>
				<texture>frame/osdfade.png</texture>
			</control>
			<control type="label">
				<left>60</left><right>60</right><top>30</top><height>60</height>
				<font>font45_title</font><align>right</align><aligny>center</aligny>
				<label>$INFO[VideoPlayer.TVShowTitle,, · ]$INFO[VideoPlayer.Season,S,]$INFO[VideoPlayer.Episode,E, · ]$INFO[VideoPlayer.Title]</label>
				<scroll>true</scroll>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label">
				<left>60</left><top>30</top><width>300</width><height>60</height>
				<font>font45</font><align>left</align><aligny>center</aligny>
				<label>$INFO[System.Time]</label>
				<shadowcolor>black</shadowcolor>
			</control>

			<!-- bottom -->
			<control type="image">
				<left>0</left><bottom>0</bottom><width>100%</width><height>420</height>
				<texture flipy="true">frame/osdfade.png</texture>
			</control>
			<control type="label">
				<left>60</left><bottom>300</bottom><width>400</width><height>50</height>
				<font>font37</font><align>left</align><aligny>center</aligny>
				<label>$INFO[Player.Time]</label>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="label">
				<right>60</right><bottom>300</bottom><width>700</width><height>50</height>
				<font>font37</font><align>right</align><aligny>center</aligny>
				<label>$INFO[Player.Duration]$INFO[Player.FinishTime,   ·   מסתיים ב-,]</label>
				<shadowcolor>black</shadowcolor>
			</control>
			<control type="group">
				<left>60</left><right>60</right><bottom>270</bottom><height>14</height>
				<control type="progress">
					<info>Player.ProgressCache</info>
					<texturebg border="3" colordiffuse="40FFFFFF">colors/white50.png</texturebg>
					<midtexture colordiffuse="60FFFFFF">colors/white50.png</midtexture>
				</control>
				<control type="progress">
					<info>Player.Progress</info>
					<texturebg border="3" colordiffuse="00FFFFFF">colors/white50.png</texturebg>
					<midtexture colordiffuse="FFE8BE5A">colors/white.png</midtexture>
				</control>
			</control>

			<!-- the buttons: one row, remote Left/Right, OK -->
			<control type="grouplist" id="201">
				<centerleft>50%</centerleft><width>1500</width><bottom>120</bottom><height>110</height>
				<orientation>horizontal</orientation><align>center</align><itemgap>18</itemgap>
				<onup>Dialog.Close(videoosd)</onup>
				<include content="BNOsdButton"><param name="id" value="601"/><param name="icon" value="previous"/><param name="label" value="הקודם"/><param name="action" value="PlayerControl(Previous)"/></include>
				<include content="BNOsdButton"><param name="id" value="602"/><param name="icon" value="rewind"/><param name="label" value="אחורה"/><param name="action" value="PlayerControl(Rewind)"/></include>
				<control type="togglebutton" id="603">
					<width>100</width><height>100</height>
					<label>נגן / השהה</label><textcolor>00000000</textcolor><focusedcolor>00000000</focusedcolor>
					<texturefocus colordiffuse="FFE8BE5A">osd/fullscreen/buttons/pause.png</texturefocus>
					<texturenofocus colordiffuse="FFFFFFFF">osd/fullscreen/buttons/pause.png</texturenofocus>
					<alttexturefocus colordiffuse="FFE8BE5A">osd/fullscreen/buttons/play.png</alttexturefocus>
					<alttexturenofocus colordiffuse="FFFFFFFF">osd/fullscreen/buttons/play.png</alttexturenofocus>
					<usealttexture>Player.Paused</usealttexture>
					<onclick>PlayerControl(Play)</onclick>
				</control>
				<include content="BNOsdButton"><param name="id" value="604"/><param name="icon" value="stop"/><param name="label" value="עצור"/><param name="action" value="PlayerControl(Stop)"/></include>
				<include content="BNOsdButton"><param name="id" value="605"/><param name="icon" value="forward"/><param name="label" value="קדימה"/><param name="action" value="PlayerControl(Forward)"/></include>
				<include content="BNOsdButton"><param name="id" value="606"/><param name="icon" value="next"/><param name="label" value="הבא"/><param name="action" value="PlayerControl(Next)"/></include>
				<control type="image"><width>4</width><height>100</height><texture colordiffuse="40FFFFFF">colors/white.png</texture></control>
				<include content="BNOsdButton"><param name="id" value="607"/><param name="icon" value="subs"/><param name="label" value="כתוביות"/><param name="action" value="RunPlugin(plugin://plugin.video.nova/?a=subs_menu)"/></include>
				<include content="BNOsdButton"><param name="id" value="608"/><param name="icon" value="subs3"/><param name="label" value="יצירת כתוביות AI"/><param name="action" value="RunPlugin(plugin://plugin.video.nova/?a=ai_subs_now)"/></include>
				<include content="BNOsdButton"><param name="id" value="609"/><param name="icon" value="subs2"/><param name="label" value="סנכרון כתוביות"/><param name="action" value="SubtitleDelay"/></include>
				<include content="BNOsdButton"><param name="id" value="610"/><param name="icon" value="audio"/><param name="label" value="שמע ושפה"/><param name="action" value="ActivateWindow(osdaudiosettings)"/></include>
				<include content="BNOsdButton"><param name="id" value="611"/><param name="icon" value="settings"/><param name="label" value="תמונה"/><param name="action" value="ActivateWindow(osdvideosettings)"/></include>
				<include content="BNOsdButton"><param name="id" value="612"/><param name="icon" value="bookmarks"/><param name="label" value="סימניות"/><param name="action" value="ActivateWindow(videobookmarks)"/></include>
				<include content="BNOsdButton"><param name="id" value="613"/><param name="icon" value="information"/><param name="label" value="מידע"/><param name="action" value="Info"/></include>
				<include content="BNOsdButton"><param name="id" value="614"/><param name="icon" value="playlist"/><param name="label" value="רשימת פרקים"/><param name="action" value="ActivateWindow(videoplaylist)"/><param name="visible" value="Integer.IsGreater(Playlist.Length(video),1)"/></include>
			</control>
			<!-- the focused button's name (big, readable from the couch) -->
			<control type="label">
				<left>0</left><width>100%</width><bottom>50</bottom><height>60</height>
				<font>font37</font><align>center</align><aligny>center</aligny>
				<textcolor>FFE8BE5A</textcolor><shadowcolor>black</shadowcolor>
				<label>$INFO[System.CurrentControl]</label>
			</control>
		</control>
	</include>

	<include name="BNOsdButton">
		<param name="visible" default="true"/>
		<definition>
			<control type="button" id="$PARAM[id]">
				<width>100</width><height>100</height>
				<label>$PARAM[label]</label><textcolor>00000000</textcolor><focusedcolor>00000000</focusedcolor>
				<texturefocus colordiffuse="FFE8BE5A">osd/fullscreen/buttons/$PARAM[icon].png</texturefocus>
				<texturenofocus colordiffuse="FFFFFFFF">osd/fullscreen/buttons/$PARAM[icon].png</texturenofocus>
				<onclick>$PARAM[action]</onclick>
				<visible>$PARAM[visible]</visible>
			</control>
		</definition>
	</include>
</includes>
